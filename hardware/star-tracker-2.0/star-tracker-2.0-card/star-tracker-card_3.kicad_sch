	(text "Unfortunately MMC0 (SD card) and the PRU share 4 pins.\nWe can get away without using them and just using the 8\nhighest bits of the camera parallel bus. However, since we\nwill ultimately be booting off of eMMC, we could then utilize\nthe 4 lowest bits. Likewise, populate once only the eMMc is\nused, cut these jumpers and connect them to the PRUs"
		(exclude_from_sim no)
		(at 61.976 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "95dc2c06-c392-4896-a502-a5f26535af57")
	)
	(text "All resistors are 0603 1% AEC-Q200 unless marked.\nAll capacitors are 0603 AEC-Q200 Vw >= 16V X5R or better unless marked."
		(exclude_from_sim no)
		(at 113.284 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c54da6d-f55e-4915-9433-aac07abb456e")
	)
